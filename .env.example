# Copy to .env.local for local development, and add the same two values in Vercel → Settings →
# Environment Variables. Both come from Supabase → Project Settings → API Keys / Data API.
# The publishable (anon) key is meant to be public: row-level security protects the data.
# Leave both empty to run the site without accounts.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
